	fromColumn: FactFearSelection.AgeGroupKey
	toColumn: DimAgeGroup.AgeGroupKey

relationship FactFearSelection_DimGender
	fromColumn: FactFearSelection.GenderKey
	toColumn: DimGender.GenderKey

