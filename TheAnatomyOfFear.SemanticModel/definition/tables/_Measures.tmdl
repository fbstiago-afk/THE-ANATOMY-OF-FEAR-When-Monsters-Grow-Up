table _Measures
	lineageTag: d2e28628-f273-4dc2-82df-4cffff0bf3ad

	/// Counts people who picked the fear shown in the chart.
	/// Each person counts once. The total counts people, even if they picked several fears.
	/// Your life stage, gender, age and country filters apply. People with no fears picked are not included.
	measure 'Number of Respondents' =
			
			// Counts people who picked the fear shown in the chart.
			// Each person counts once. The total counts people, even if they picked several fears.
			DISTINCTCOUNT ( 'FactFearSelection'[ResponseKey] )
		formatString: #,##0
		displayFolder: Starter Measures
		lineageTag: 447081b7-6edc-45bd-9a89-ebeaf7a5f904

	/// Counts fears people picked both as kids and as adults.
	/// If someone picked spiders in both lists, that counts as 1.
	/// If they picked spiders and heights in both lists, they add 2 to the total.
	measure 'Responses Where Fears Remained' =
			// Counts fears people picked both as kids and as adults.
			// If someone picked spiders in both lists, that counts as 1.
			CALCULATE (
			    COUNTROWS (
			        SUMMARIZE (
			            'FactFearSelection',
			            'FactFearSelection'[ResponseKey],
			            'FactFearSelection'[FearKey]
			        )
			    ),
			    KEEPFILTERS ( 'FactFearSelection'[IsRetained] = TRUE () )
			)
		formatString: #,##0
		displayFolder: Starter Measures
		lineageTag: c0184d62-3af2-4688-9b8d-bbfadf289ae4

	/// Counts how many fears people picked.
	/// If someone picked three fears, they add 3 to the total.
	/// The same fear picked as a kid and as an adult counts twice when both stages are shown.
	measure 'Number of Fear Selections' =
			
			// Counts how many fears people picked.
			// If someone picked three fears, they add 3 to the total.
			COUNTROWS ( 'FactFearSelection' )
		formatString: #,##0
		displayFolder: Starter Measures
		lineageTag: 80c875b7-033f-45e5-adc4-e71b3cc3c409

	/// Counts fears people picked as kids but not as adults.
	/// If someone picked two of these fears, they add 2 to the total.
	measure 'Childhood-Only Fear Selections' =
			
			// Counts fears people picked as kids but not as adults.
			// If someone picked two of these fears, they add 2 to the total.
			CALCULATE (
			    COUNTROWS (
			        SUMMARIZE (
			            'FactFearSelection',
			            'FactFearSelection'[ResponseKey],
			            'FactFearSelection'[FearKey]
			        )
			    ),
			    KEEPFILTERS ( 'FactFearSelection'[FearPattern] = "Childhood only" )
			)
		formatString: #,##0
		displayFolder: Starter Measures
		lineageTag: 8ce0e342-4762-4e56-8094-fc6911269d99

	/// Counts fears people picked as adults but not as kids.
	/// If someone picked two of these fears, they add 2 to the total.
	measure 'Adult-Only Fear Selections' =
			
			// Counts fears people picked as adults but not as kids.
			// If someone picked two of these fears, they add 2 to the total.
			CALCULATE (
			    COUNTROWS (
			        SUMMARIZE (
			            'FactFearSelection',
			            'FactFearSelection'[ResponseKey],
			            'FactFearSelection'[FearKey]
			        )
			    ),
			    KEEPFILTERS ( 'FactFearSelection'[FearPattern] = "Adult only" )
			)
		formatString: #,##0
		displayFolder: Starter Measures
		lineageTag: fb223b51-21d6-4697-9919-5f751467da3c

	/// Shows the percentage of people who picked a fear.
	/// For example, 20% means 1 in 5 people in the chosen group picked it.
	/// People with no fears picked are not included. People can pick several fears, so the percentages can add up to more than 100%.
	measure 'Respondents Selecting Fear (%)' =
			// Shows the percentage of people who picked a fear.
			// For example, 20% means 1 in 5 people in the chosen group picked it.
			VAR _respondentsSelectingFear =
			    [Number of Respondents]
			VAR _respondentsInGroup =
			    CALCULATE (
			        [Number of Respondents],
			        REMOVEFILTERS ( 'DimFear' )
			    )
			RETURN
			    DIVIDE ( _respondentsSelectingFear, _respondentsInGroup )
		formatString: 0.0%
		displayFolder: Starter Measures
		lineageTag: 6ae94dbc-0d87-40d1-b018-20ff3e1a3bd9

	/// Survey responses (one row per ResponseKey in Respondent). Denominator for every share on the poster.
	measure Responses = COUNTROWS ( Respondent )
		formatString: #,0
		displayFolder: Anatomy of Fear\1 Core
		lineageTag: d28bd4da-3547-4668-a0d5-80764243f0a3

	/// Fear selections in the childhood list. A respondent could select several fears, so this is NOT a count of people.
	measure 'Childhood Fear Mentions' =
			CALCULATE (
			    COUNTROWS ( FactFearSelection ),
			    KEEPFILTERS ( FactFearSelection[LifeStage] = "Childhood" )
			)
		formatString: #,0
		displayFolder: Anatomy of Fear\1 Core
		lineageTag: d027de88-4569-4c0c-ab3d-a0f802798e10

	/// Fear selections in the current (adult) list. A respondent could select several fears, so this is NOT a count of people.
	measure 'Current Fear Mentions' =
			CALCULATE (
			    COUNTROWS ( FactFearSelection ),
			    KEEPFILTERS ( FactFearSelection[LifeStage] = "Adult" )
			)
		formatString: #,0
		displayFolder: Anatomy of Fear\1 Core
		lineageTag: 992e0499-a5dd-4782-a56a-6a218e217358

	/// Largest number of fears any respondent selected in one list (childhood or current).
	measure 'Max Fears per List' = MAX ( MAX ( Respondent[ChildhoodFearCount] ), MAX ( Respondent[CurrentFearCount] ) )
		formatString: 0
		displayFolder: Anatomy of Fear\1 Core
		lineageTag: 878b0cd1-7b23-4709-a378-7fc3dc97cbb9

	/// Distinct respondents who selected the fear(s) in context, in any period (respects a LifeStage filter if present).
	measure 'Respondents by Fear' = DISTINCTCOUNT ( FactFearSelection[ResponseKey] )
		formatString: #,0
		displayFolder: Anatomy of Fear\2 Fears by period
		lineageTag: 3b0335dc-2955-47b1-960e-8f5b0c1aadc4

	/// Distinct respondents who selected the fear in their childhood list.
	measure 'Childhood Respondents' =
			CALCULATE (
			    DISTINCTCOUNT ( FactFearSelection[ResponseKey] ),
			    KEEPFILTERS ( FactFearSelection[LifeStage] = "Childhood" )
			)
		formatString: #,0
		displayFolder: Anatomy of Fear\2 Fears by period
		lineageTag: 43ae7b3d-5149-46ae-9a27-2762bba7a59a

	/// Distinct respondents who selected the fear in their current (adult) list.
	measure 'Now Respondents' =
			CALCULATE (
			    DISTINCTCOUNT ( FactFearSelection[ResponseKey] ),
			    KEEPFILTERS ( FactFearSelection[LifeStage] = "Adult" )
			)
		formatString: #,0
		displayFolder: Anatomy of Fear\2 Fears by period
		lineageTag: cf79cd93-81a9-4535-93ab-8f36b98957a7

	/// Distinct respondents who selected exactly the same fear in BOTH lists (IsRetained). Not a causal or continuous-fear claim.
	measure 'Kept Respondents' =
			CALCULATE (
			    DISTINCTCOUNT ( FactFearSelection[ResponseKey] ),
			    KEEPFILTERS ( FactFearSelection[IsRetained] = TRUE () )
			)
		formatString: #,0
		displayFolder: Anatomy of Fear\2 Fears by period
		lineageTag: f1144878-f8d4-4b7b-ab61-b9e35a19e4d0

	/// Respondents selecting the fear in context divided by all respondents.
	measure 'Fear Share' = DIVIDE ( [Respondents by Fear], [Responses] )
		formatString: 0.0%
		displayFolder: Anatomy of Fear\2 Fears by period
		lineageTag: fe1b3f5b-17be-4452-9ead-6ec83a33472b

	/// Childhood respondents for the fear divided by all respondents.
	measure 'Childhood Fear Share' = DIVIDE ( [Childhood Respondents], [Responses] )
		formatString: 0.0%
		displayFolder: Anatomy of Fear\2 Fears by period
		lineageTag: 72ca7f8b-cc22-4d47-8cf0-1329c9557405

	/// Current respondents for the fear divided by all respondents.
	measure 'Now Fear Share' = DIVIDE ( [Now Respondents], [Responses] )
		formatString: 0.0%
		displayFolder: Anatomy of Fear\2 Fears by period
		lineageTag: 009c7703-908d-448a-a9e1-2ac1f1e05b16

	/// Current respondents minus childhood respondents for the fear. Difference between two aggregate counts, NOT individual transitions.
	measure 'Fear Change' = COALESCE ( [Now Respondents], 0 ) - COALESCE ( [Childhood Respondents], 0 )
		formatString: +0;-0;0
		displayFolder: Anatomy of Fear\2 Fears by period
		lineageTag: 814a79a4-fdcf-4d07-91aa-c114f3f0d7ee

	/// Current share minus childhood share (percentage points of all respondents).
	measure 'Fear Share Difference' = COALESCE ( [Now Fear Share], 0 ) - COALESCE ( [Childhood Fear Share], 0 )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Anatomy of Fear\2 Fears by period
		lineageTag: f25fe696-2464-44bd-bf77-c4f19739dd1f

	/// Rank of the fear by childhood respondents (1 = most selected, ties share a rank, SKIP). Excludes non-fear answers (Other Responses category).
	measure 'Childhood Rank' =
			VAR _value = [Childhood Respondents]
			VAR _isFear = SELECTEDVALUE ( DimFear[Category] ) <> "Other Responses"
			RETURN
			    IF (
			        HASONEVALUE ( DimFear[Fear] ) && _isFear && _value > 0,
			        RANKX ( CALCULATETABLE (
			        VALUES ( DimFear[Fear] ),
			        DimFear[Category] <> "Other Responses",
			        REMOVEFILTERS ( DimFear )
			    ), [Childhood Respondents], _value, DESC, SKIP )
			    )
		formatString: 0
		displayFolder: Anatomy of Fear\2 Fears by period
		lineageTag: 90fc0f82-bda8-4055-8d49-cf3c42a92ddf

	/// Rank of the fear by current respondents (1 = most selected, ties share a rank, SKIP). Excludes non-fear answers.
	measure 'Now Rank' =
			VAR _value = [Now Respondents]
			VAR _isFear = SELECTEDVALUE ( DimFear[Category] ) <> "Other Responses"
			RETURN
			    IF (
			        HASONEVALUE ( DimFear[Fear] ) && _isFear && _value > 0,
			        RANKX ( CALCULATETABLE (
			        VALUES ( DimFear[Fear] ),
			        DimFear[Category] <> "Other Responses",
			        REMOVEFILTERS ( DimFear )
			    ), [Now Respondents], _value, DESC, SKIP )
			    )
		formatString: 0
		displayFolder: Anatomy of Fear\2 Fears by period
		lineageTag: 4d85709c-b572-49a1-859b-0a83f7e28427

	/// Rank of the fear by respondents in the current filter context (for example a LifeStage filter).
	measure 'Fear Rank' =
			VAR _value = [Respondents by Fear]
			VAR _isFear = SELECTEDVALUE ( DimFear[Category] ) <> "Other Responses"
			RETURN
			    IF (
			        HASONEVALUE ( DimFear[Fear] ) && _isFear && _value > 0,
			        RANKX ( CALCULATETABLE (
			        VALUES ( DimFear[Fear] ),
			        DimFear[Category] <> "Other Responses",
			        REMOVEFILTERS ( DimFear )
			    ), [Respondents by Fear], _value, DESC, SKIP )
			    )
		formatString: 0
		displayFolder: Anatomy of Fear\2 Fears by period
		lineageTag: 22baa91e-e892-4c86-ab37-126f187f3b80

	/// Display rule (not data): a fear appears on the spine chart when it ranks within this Top N in either period.
	measure 'Spine Top N' = 5
		formatString: 0
		displayFolder: Anatomy of Fear\2 Fears by period
		lineageTag: fb966d35-f2a9-4d56-9e54-4f06a1b391c2

	/// 1 when the fear ranks within [Spine Top N] in childhood OR today; otherwise 0. Used by the Deneb spine chart.
	measure 'Spine Include' =
			VAR _c = [Childhood Rank]
			VAR _n = [Now Rank]
			VAR _top = [Spine Top N]
			RETURN
			    IF (
			        ( NOT ISBLANK ( _c ) && _c <= _top ) || ( NOT ISBLANK ( _n ) && _n <= _top ),
			        1,
			        0
			    )
		formatString: 0
		displayFolder: Anatomy of Fear\2 Fears by period
		lineageTag: ea61ba45-c0c7-40c3-9331-81747399aaf9

	/// Most selected childhood fear (ties broken alphabetically).
	measure 'Top Childhood Fear' =
			VAR _t = TOPN ( 1, CALCULATETABLE (
			        VALUES ( DimFear[Fear] ),
			        DimFear[Category] <> "Other Responses",
			        REMOVEFILTERS ( DimFear )
			    ), [Childhood Respondents], DESC, DimFear[Fear], ASC )
			RETURN MAXX ( _t, DimFear[Fear] )
		displayFolder: Anatomy of Fear\2 Fears by period
		lineageTag: 4dc33a64-b3b9-4376-b065-86eed080ae82

	/// Respondents who selected the top childhood fear.
	measure 'Top Childhood Fear Respondents' = CALCULATE ( [Childhood Respondents], TREATAS ( { [Top Childhood Fear] }, DimFear[Fear] ) )
		formatString: #,0
		displayFolder: Anatomy of Fear\2 Fears by period
		lineageTag: 4b71ecf6-b1b0-4df8-97c2-f36e12761e88

	/// Most selected current fear (ties broken alphabetically).
	measure 'Top Current Fear' =
			VAR _t = TOPN ( 1, CALCULATETABLE (
			        VALUES ( DimFear[Fear] ),
			        DimFear[Category] <> "Other Responses",
			        REMOVEFILTERS ( DimFear )
			    ), [Now Respondents], DESC, DimFear[Fear], ASC )
			RETURN MAXX ( _t, DimFear[Fear] )
		displayFolder: Anatomy of Fear\2 Fears by period
		lineageTag: 07b376c5-84f0-4885-be55-751ebe32fc37

	/// Respondents who selected the top current fear.
	measure 'Top Current Fear Respondents' = CALCULATE ( [Now Respondents], TREATAS ( { [Top Current Fear] }, DimFear[Fear] ) )
		formatString: #,0
		displayFolder: Anatomy of Fear\2 Fears by period
		lineageTag: 72127049-ed30-4280-83cc-903362943d69

	/// Fear with the largest positive [Fear Change] (ties: more current respondents, then alphabetical).
	measure 'Biggest Rise Fear' =
			VAR _t = TOPN ( 1, CALCULATETABLE (
			        VALUES ( DimFear[Fear] ),
			        DimFear[Category] <> "Other Responses",
			        REMOVEFILTERS ( DimFear )
			    ), [Fear Change], DESC, [Now Respondents], DESC, DimFear[Fear], ASC )
			RETURN MAXX ( _t, DimFear[Fear] )
		displayFolder: Anatomy of Fear\2 Fears by period
		lineageTag: 1675ff81-b352-43b1-a625-2d5bf7c546ac

	/// Fear with the most negative [Fear Change] (ties: more childhood respondents, then alphabetical).
	measure 'Biggest Fall Fear' =
			VAR _t = TOPN ( 1, CALCULATETABLE (
			        VALUES ( DimFear[Fear] ),
			        DimFear[Category] <> "Other Responses",
			        REMOVEFILTERS ( DimFear )
			    ), [Fear Change], ASC, [Childhood Respondents], DESC, DimFear[Fear], ASC )
			RETURN MAXX ( _t, DimFear[Fear] )
		displayFolder: Anatomy of Fear\2 Fears by period
		lineageTag: 2cf5c590-3cca-4eaf-a49e-826c1810cf2b

	/// Most selected current fear that NO respondent selected in the childhood list.
	measure 'Adult Only Top Fear' =
			VAR _candidates =
			    FILTER ( CALCULATETABLE (
			        VALUES ( DimFear[Fear] ),
			        DimFear[Category] <> "Other Responses",
			        REMOVEFILTERS ( DimFear )
			    ), ISBLANK ( [Childhood Respondents] ) && [Now Respondents] > 0 )
			VAR _t = TOPN ( 1, _candidates, [Now Respondents], DESC, DimFear[Fear], ASC )
			RETURN MAXX ( _t, DimFear[Fear] )
		displayFolder: Anatomy of Fear\2 Fears by period
		lineageTag: 0caa978f-2195-4ccc-bc28-a658347c3767

	/// Fear selected in both lists by the most respondents (ties: higher share of childhood respondents kept, then alphabetical).
	measure 'Most Loyal Fear' =
			VAR _t =
			    TOPN ( 1, CALCULATETABLE (
			        VALUES ( DimFear[Fear] ),
			        DimFear[Category] <> "Other Responses",
			        REMOVEFILTERS ( DimFear )
			    ), [Kept Respondents], DESC, DIVIDE ( [Kept Respondents], [Childhood Respondents] ), DESC, DimFear[Fear], ASC )
			RETURN MAXX ( _t, DimFear[Fear] )
		displayFolder: Anatomy of Fear\2 Fears by period
		lineageTag: c6069435-c860-4dc9-98de-ad88ea388f3f

	/// Respondents who selected at least one identical fear in their childhood and current lists.
	measure 'Persistent Fear Respondents' = CALCULATE ( [Responses], KEEPFILTERS ( Respondent[FearsKept] > 0 ) )
		formatString: #,0
		displayFolder: Anatomy of Fear\3 Persistence
		lineageTag: 58e9e8bf-8e62-4fef-9c81-a8703e527721

	/// [Persistent Fear Respondents] / [Responses].
	measure 'Persistent Fear %' = DIVIDE ( [Persistent Fear Respondents], [Responses] )
		formatString: 0.0%
		displayFolder: Anatomy of Fear\3 Persistence
		lineageTag: baf0ed88-0cae-41b4-b8a6-344efd68f0f2

	/// Respondents with no identical fear in both lists.
	measure 'No Fear Kept Respondents' = CALCULATE ( [Responses], KEEPFILTERS ( Respondent[FearsKept] = 0 ) )
		formatString: #,0
		displayFolder: Anatomy of Fear\3 Persistence
		lineageTag: fafcb260-38ce-4ee6-a7c6-031df9721d2c

	/// Independent re-computation of persistence from FactFearSelection[IsRetained]; must equal [Persistent Fear Respondents].
	measure 'Persistent Fear Respondents (Fact check)' =
			CALCULATE (
			    DISTINCTCOUNT ( FactFearSelection[ResponseKey] ),
			    FactFearSelection[IsRetained] = TRUE (),
			    REMOVEFILTERS ( DimFear )
			)
		formatString: #,0
		displayFolder: Anatomy of Fear\9 QA
		lineageTag: a077bfb6-4f31-49ca-b88e-dfa7a93bdcaa

	/// Most chosen data nightmare (short label; single-choice question).
	measure 'Top Data Nightmare' =
			VAR _t = TOPN ( 1, ALL ( Respondent[Nightmare] ), [Responses], DESC, Respondent[Nightmare], ASC )
			RETURN MAXX ( _t, Respondent[Nightmare] )
		displayFolder: Anatomy of Fear\4 Data nightmares
		lineageTag: ca6e82fc-d922-4897-8efc-7c898024ef7b

	/// Text in brackets of the original answer for the top data nightmare.
	measure 'Top Data Nightmare Detail' =
			VAR _top = [Top Data Nightmare]
			RETURN
			    MAXX ( FILTER ( ALL ( Respondent[Nightmare], Respondent[NightmareDetail] ), Respondent[Nightmare] = _top ), Respondent[NightmareDetail] )
		displayFolder: Anatomy of Fear\4 Data nightmares
		lineageTag: 6622e3bc-d243-48bd-8700-1ec77bdc9d4e

	/// Respondents who chose the top data nightmare.
	measure 'Data Nightmare Respondents' = CALCULATE ( [Responses], TREATAS ( { [Top Data Nightmare] }, Respondent[Nightmare] ) )
		formatString: #,0
		displayFolder: Anatomy of Fear\4 Data nightmares
		lineageTag: 04f8ea90-4c85-4ef0-9df5-b5e561d9da7c

	/// [Data Nightmare Respondents] / all respondents.
	measure 'Data Nightmare %' = DIVIDE ( [Data Nightmare Respondents], CALCULATE ( [Responses], REMOVEFILTERS ( Respondent ) ) )
		formatString: 0.0%
		displayFolder: Anatomy of Fear\4 Data nightmares
		lineageTag: f86f07bd-0891-4674-854b-244f22d4832f

	/// Respondents choosing the nightmare in context / all respondents.
	measure 'Nightmare Share' = DIVIDE ( [Responses], CALCULATE ( [Responses], REMOVEFILTERS ( Respondent ) ) )
		formatString: 0.0%
		displayFolder: Anatomy of Fear\4 Data nightmares
		lineageTag: 954103dc-5fd1-4722-872b-92f783e3822a

	/// Rank of the nightmare answer by respondents (1 = most chosen).
	measure 'Nightmare Rank' =
			IF (
			    HASONEVALUE ( Respondent[Nightmare] ),
			    RANKX ( ALL ( Respondent[Nightmare] ), [Responses], , DESC, SKIP )
			)
		formatString: 0
		displayFolder: Anatomy of Fear\4 Data nightmares
		lineageTag: 4560512f-c8d4-4855-9c49-42d535b95b32

	/// Method strip under the headline.
	measure 'Text Survey Strip' =
			FORMAT ( [Responses], "#,0" ) & " respondents   " & UNICHAR ( 183 ) & "   "
			    & FORMAT ( [Childhood Fear Mentions], "#,0" ) & " childhood + "
			    & FORMAT ( [Current Fear Mentions], "#,0" ) & " current fear selections   " & UNICHAR ( 183 ) & "   up to "
			    & [Max Fears per List] & " fears per list"
		displayFolder: Anatomy of Fear\5 Poster text
		lineageTag: 1b18315d-df37-4822-814a-5539fc934eec

	/// e.g. War: 5 -> 19 (respondents, childhood -> today).
	measure 'Text Biggest Rise' =
			VAR _f = [Biggest Rise Fear]
			VAR _c = CALCULATE ( COALESCE ( [Childhood Respondents], 0 ), TREATAS ( { _f }, DimFear[Fear] ) )
			VAR _n = CALCULATE ( COALESCE ( [Now Respondents], 0 ), TREATAS ( { _f }, DimFear[Fear] ) )
			RETURN _f & ":  " & _c & "  " & UNICHAR ( 8594 ) & "  " & _n
		displayFolder: Anatomy of Fear\5 Poster text
		lineageTag: 6fe5103b-7f8e-4528-93f6-095f7f403b1c

	/// e.g. The dark: 11 -> 2 (respondents, childhood -> today).
	measure 'Text Biggest Fall' =
			VAR _f = [Biggest Fall Fear]
			VAR _c = CALCULATE ( COALESCE ( [Childhood Respondents], 0 ), TREATAS ( { _f }, DimFear[Fear] ) )
			VAR _n = CALCULATE ( COALESCE ( [Now Respondents], 0 ), TREATAS ( { _f }, DimFear[Fear] ) )
			RETURN _f & ":  " & _c & "  " & UNICHAR ( 8594 ) & "  " & _n
		displayFolder: Anatomy of Fear\5 Poster text
		lineageTag: 67e1a46c-5eb5-433e-b422-fadfd414041e

	/// Top fear that no respondent named as a child, childhood -> today.
	measure 'Text Adult Only' =
			VAR _f = [Adult Only Top Fear]
			VAR _c = CALCULATE ( COALESCE ( [Childhood Respondents], 0 ), TREATAS ( { _f }, DimFear[Fear] ) )
			VAR _n = CALCULATE ( COALESCE ( [Now Respondents], 0 ), TREATAS ( { _f }, DimFear[Fear] ) )
			RETURN _f & ":  " & _c & "  " & UNICHAR ( 8594 ) & "  " & _n
		displayFolder: Anatomy of Fear\5 Poster text
		lineageTag: d6fab73a-714f-4888-8501-62984f474760

	/// Hero number for Act III.
	measure 'Text Persistent %' = FORMAT ( [Persistent Fear %], "0.0%" )
		displayFolder: Anatomy of Fear\5 Poster text
		lineageTag: 91c0bb6d-c8cc-4fa7-a806-be7cfe89f738

	/// 45 of 105 respondents.
	measure 'Text Persistent Count' = FORMAT ( [Persistent Fear Respondents], "#,0" ) & " of " & FORMAT ( [Responses], "#,0" ) & " respondents"
		displayFolder: Anatomy of Fear\5 Poster text
		lineageTag: e9a43c29-5e41-44f3-9f3d-f1092cc8e073

	/// Most loyal monster sentence.
	measure 'Text Most Loyal' =
			VAR _f = [Most Loyal Fear]
			VAR _k = CALCULATE ( [Kept Respondents], TREATAS ( { _f }, DimFear[Fear] ) )
			VAR _c = CALCULATE ( [Childhood Respondents], TREATAS ( { _f }, DimFear[Fear] ) )
			RETURN
			    "Most loyal monster:  " & _f & "  " & UNICHAR ( 8212 ) & "  " & _k & " of the " & _c
			        & " who named it as children still name it today"
		displayFolder: Anatomy of Fear\5 Poster text
		lineageTag: 4f92084c-1395-4621-872b-30efd0f3b83d

	/// Alt text for the Deneb spine chart.
	measure 'Alt Spine' =
			VAR _tc = [Top Childhood Fear]
			VAR _tn = [Top Current Fear]
			RETURN
			    "Fears then and now, in respondents out of " & [Responses] & ". As children, the most named fear was "
			        & _tc & " (" & [Top Childhood Fear Respondents] & "). Today it is " & _tn & " (" & [Top Current Fear Respondents]
			        & "). Biggest rise: " & SUBSTITUTE ( [Text Biggest Rise], ":  ", " from " ) & ". Biggest fall: " & SUBSTITUTE ( [Text Biggest Fall], ":  ", " from " )
			        & ". Nobody named " & [Adult Only Top Fear] & " as a child; " & CALCULATE ( [Now Respondents], TREATAS ( { [Adult Only Top Fear] }, DimFear[Fear] ) )
			        & " name it today."
		displayFolder: Anatomy of Fear\6 Accessibility
		lineageTag: 8a728659-c296-4924-9edb-0a92d2f31ab8

	/// Alt text for the 105 ghosts unit chart.
	measure 'Alt Ghosts' =
			"One ghost per respondent. " & [Persistent Fear Respondents] & " of " & [Responses] & " ("
			    & FORMAT ( [Persistent Fear %], "0.0%" ) & ") named at least one identical fear as a child and today: "
			    & CALCULATE ( [Responses], Respondent[FearsKept] = 1 ) & " kept one, "
			    & CALCULATE ( [Responses], Respondent[FearsKept] = 2 ) & " kept two, "
			    & CALCULATE ( [Responses], Respondent[FearsKept] = 3 ) & " kept three. "
			    & [No Fear Kept Respondents] & " kept none. " & [Text Most Loyal] & "."
		displayFolder: Anatomy of Fear\6 Accessibility
		lineageTag: 10355e4e-3e3c-4f76-8923-d974a849d83f

	/// Alt text for the data nightmare chart and card.
	measure 'Alt Nightmares' =
			"Worst data nightmare, one answer per respondent: " & [Top Data Nightmare] & " ("
			    & [Top Data Nightmare Detail] & ") was chosen by " & [Data Nightmare Respondents] & " of " & [Responses]
			    & " respondents (" & FORMAT ( [Data Nightmare %], "0.0%" ) & "), the most common answer."
		displayFolder: Anatomy of Fear\6 Accessibility
		lineageTag: a5a70700-eb8d-4e0f-b64d-22304366d570

	/// Alt text for the persistence hero number.
	measure 'Alt Persistent' =
			[Persistent Fear Respondents] & " of " & [Responses] & " respondents, " & FORMAT ( [Persistent Fear %], "0.0%" )
			    & ", named at least one identical fear as a child and as an adult."
		displayFolder: Anatomy of Fear\6 Accessibility
		lineageTag: 0b6d8845-92ae-4b7f-9036-40cd132ab03c

	/// Decorative animated ghost for the HTML Content visual (static SVG + CSS, no script).
	measure 'HTML Ghost' = "<style>.fg{width:100%;height:100%;display:flex;align-items:center;justify-content:center;overflow:hidden}.fg svg{width:88%;height:auto;filter:drop-shadow(0 0 16px rgba(189,154,247,.55));animation:fgfloat 7s ease-in-out infinite}.fg .eye{animation:fgblink 6s infinite;transform-origin:center;transform-box:fill-box}.fg .flame{animation:fgflick 1.8s ease-in-out infinite;transform-origin:50% 100%;transform-box:fill-box}@keyframes fgfloat{0%,100%{transform:translateY(4px)}50%{transform:translateY(-10px)}}@keyframes fgblink{0%,90%,100%{transform:scaleY(1)}93%{transform:scaleY(.08)}96%{transform:scaleY(1)}}@keyframes fgflick{0%,100%{transform:scale(1,1);opacity:1}50%{transform:scale(.88,1.12);opacity:.85}}@media (prefers-reduced-motion: reduce){.fg svg,.fg .eye,.fg .flame{animation:none}}</style><div class='fg'><svg viewBox='0 0 220 260' aria-hidden='true' focusable='false'><defs><linearGradient id='fgb' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#F4EBDD' stop-opacity='.92'/><stop offset='.55' stop-color='#D9CDE8' stop-opacity='.62'/><stop offset='1' stop-color='#BD9AF7' stop-opacity='0'/></linearGradient><radialGradient id='fgf' cx='.5' cy='.6' r='.5'><stop offset='0' stop-color='#FFF3D6'/><stop offset='.55' stop-color='#FFB886'/><stop offset='1' stop-color='#FF858E' stop-opacity='0'/></radialGradient></defs><path d='M112 18 C74 18 56 50 54 92 C51 138 44 176 24 218 C42 212 54 222 64 240 C74 226 86 228 98 244 C108 230 120 230 130 244 C140 230 152 228 164 238 C172 206 176 166 172 118 C168 58 150 18 112 18 Z' fill='url(#fgb)'/><path d='M60 150 C70 170 66 196 50 214' stroke='#F4EBDD' stroke-opacity='.25' stroke-width='3' fill='none'/><path d='M150 112 C158 150 160 188 154 226' stroke='#BD9AF7' stroke-opacity='.30' stroke-width='3' fill='none'/><ellipse class='eye' cx='95' cy='88' rx='7' ry='12' fill='#151020' transform='rotate(-8 95 88)'/><ellipse class='eye' cx='129' cy='88' rx='7' ry='12' fill='#151020' transform='rotate(8 129 88)'/><path d='M168 132 C182 136 190 144 194 154' stroke='#E3D8EC' stroke-width='9' fill='none' stroke-linecap='round' opacity='.75'/><rect x='189' y='154' width='12' height='30' rx='2' fill='#F4EBDD'/><path d='M195 154 L195 149' stroke='#151020' stroke-width='2'/><ellipse cx='195' cy='150' rx='24' ry='26' fill='url(#fgf)' opacity='.35'/><path class='flame' d='M195 132 C201 140 202 145 195 150 C188 145 189 140 195 132 Z' fill='url(#fgf)'/></svg></div>"
		displayFolder: Anatomy of Fear\7 HTML
		lineageTag: 20d1a02e-eaed-4e30-85ee-068ebc3c50df

	/// Data nightmare card for the HTML Content visual; numbers come from measures.
	measure 'HTML Data Nightmare' =
			"<style>.nm{font-family:'Segoe UI',sans-serif;color:#F4EBDD;display:flex;gap:14px;align-items:center;height:100%;padding:10px 16px;box-sizing:border-box;border:1px solid #6B5590;border-radius:16px;background:linear-gradient(160deg,#2A1B37 0%,#1A1124 100%);box-shadow:inset 0 0 28px rgba(255,133,142,.14)}.nm .ic{flex:0 0 104px}.nm .num{font-family:Georgia,serif;font-size:62px;line-height:.95;color:#FF858E;letter-spacing:-1px}.nm .of{font-size:14px;font-weight:600;margin-top:2px}.nm .q{font-family:Georgia,serif;font-style:italic;font-size:19px;margin:5px 0 1px;color:#F4EBDD}.nm .d{font-size:12.5px;line-height:1.25;color:#C9B8E0}.nm .err{animation:nmflick 3.4s infinite}.nm .drip{animation:nmdrip 4s ease-in infinite}@keyframes nmflick{0%,46%,54%,100%{opacity:1}50%{opacity:.25}}@keyframes nmdrip{0%{transform:translateY(0);opacity:1}80%{transform:translateY(16px);opacity:1}100%{transform:translateY(20px);opacity:0}}@media (prefers-reduced-motion: reduce){.nm .err,.nm .drip{animation:none}}</style><div class='nm'><svg class='ic' width='104' height='132' viewBox='0 0 118 150' aria-hidden='true' focusable='false'><rect x='6' y='14' width='106' height='122' rx='6' fill='#151020' stroke='#BD9AF7' stroke-width='2'/><rect x='6' y='14' width='106' height='20' rx='6' fill='#FF858E'/><path d='M20 34 C20 44 26 44 26 34 Z M52 34 C52 50 60 50 60 34 Z M88 34 C88 41 93 41 93 34 Z' fill='#FF858E'/><circle class='drip' cx='23' cy='42' r='3' fill='#FF858E'/><g stroke='#5A4775' stroke-width='1'><line x1='6' y1='60' x2='112' y2='60'/><line x1='6' y1='85' x2='112' y2='85'/><line x1='6' y1='110' x2='112' y2='110'/><line x1='42' y1='34' x2='42' y2='136'/><line x1='77' y1='34' x2='77' y2='136'/></g><rect x='12' y='44' width='24' height='7' rx='3' fill='#F4EBDD'/><rect x='83' y='44' width='22' height='7' rx='3' fill='#F4EBDD'/><rect class='err' x='47' y='40' width='25' height='15' rx='2' fill='none' stroke='#FF858E' stroke-width='1.6' stroke-dasharray='3 2'/><rect x='12' y='69' width='24' height='7' rx='3' fill='#B4F2C4'/><rect x='50' y='66' width='22' height='7' rx='3' fill='#B4F2C4' opacity='.45'/><rect x='47' y='70' width='24' height='7' rx='3' fill='#B4F2C4'/><rect x='83' y='69' width='24' height='7' rx='3' fill='#B4F2C4'/><rect x='12' y='94' width='12' height='7' rx='3' fill='#FFB886'/><rect x='55' y='94' width='17' height='7' rx='3' fill='#FFB886'/><g fill='#FFB886'><circle cx='87' cy='97.5' r='2.4'/><circle cx='94' cy='97.5' r='2.4'/><circle cx='101' cy='97.5' r='2.4'/></g><path d='M10 124 L28 116 L40 128 L58 114 L72 127 L90 117 L108 126' fill='none' stroke='#FF858E' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/><line x1='100' y1='0' x2='100' y2='16' stroke='#C9B8E0' stroke-width='1'/><g fill='#151020' stroke='#C9B8E0' stroke-width='1'><ellipse cx='100' cy='9' rx='4' ry='3.4'/></g></svg><div><div class='num'>"
			    & FORMAT ( [Data Nightmare Respondents], "#,0" )
			    & "</div><div class='of'>of "
			    & FORMAT ( [Responses], "#,0" )
			    & " respondents &#183; "
			    & FORMAT ( [Data Nightmare %], "0.0%" )
			    & "</div><div class='q'>&#8220;"
			    & [Top Data Nightmare]
			    & "&#8221;</div><div class='d'>"
			    & [Top Data Nightmare Detail]
			    & "</div></div></div>"
		displayFolder: Anatomy of Fear\7 HTML
		lineageTag: 72aca63a-0f6c-473a-bf1c-beacd62bc70e

	/// Hovered fear (tooltip page).
	measure 'TT Fear Name' = SELECTEDVALUE ( DimFear[Fear], "Several fears" )
		displayFolder: Anatomy of Fear\8 Tooltips
		lineageTag: eb90cdfd-3c6e-4d4b-bab4-379fe4c65576

	/// Survey category of the hovered fear.
	measure 'TT Fear Category' = "Survey category:  " & SELECTEDVALUE ( DimFear[Category], "-" )
		displayFolder: Anatomy of Fear\8 Tooltips
		lineageTag: 51023a4f-1ede-4d70-a366-2bd4b6d185fb

	/// Respondents and share, childhood list.
	measure 'TT Childhood Text' = FORMAT ( COALESCE ( [Childhood Respondents], 0 ), "0" ) & "   " & UNICHAR ( 183 ) & "   " & FORMAT ( COALESCE ( [Childhood Fear Share], 0 ), "0.0%" )
		displayFolder: Anatomy of Fear\8 Tooltips
		lineageTag: fd233029-dda3-4834-8e58-e17466393128

	/// Respondents and share, current list.
	measure 'TT Now Text' = FORMAT ( COALESCE ( [Now Respondents], 0 ), "0" ) & "   " & UNICHAR ( 183 ) & "   " & FORMAT ( COALESCE ( [Now Fear Share], 0 ), "0.0%" )
		displayFolder: Anatomy of Fear\8 Tooltips
		lineageTag: ac1999b2-7912-4290-8b85-99f7ec56e49e

	/// Same respondents in both lists, out of childhood respondents.
	measure 'TT Kept Text' = FORMAT ( COALESCE ( [Kept Respondents], 0 ), "0" ) & " of " & FORMAT ( COALESCE ( [Childhood Respondents], 0 ), "0" )
		displayFolder: Anatomy of Fear\8 Tooltips
		lineageTag: 155bedc7-9873-4aa9-b7a0-36cdd24c89bf

	/// Respondents with at least one identical fear (for the age-group tooltip chart).
	measure 'TT Persist Count' = [Persistent Fear Respondents]
		formatString: #,0
		displayFolder: Anatomy of Fear\8 Tooltips
		lineageTag: 6305b2dd-1c93-4143-93ba-4a6814f9ce17

	/// Respondents in the group (for the age-group tooltip chart).
	measure 'TT Persist Size' = [Responses]
		formatString: #,0
		displayFolder: Anatomy of Fear\8 Tooltips
		lineageTag: 0afa6e68-2415-4617-aa82-cad34d7a9a4a

	/// Hovered data nightmare.
	measure 'TT Nightmare Name' = SELECTEDVALUE ( Respondent[Nightmare], "All data nightmares" )
		displayFolder: Anatomy of Fear\8 Tooltips
		lineageTag: 640fd4d4-726c-415c-b8cb-c4cea46a9297

	/// Bracketed detail of the hovered data nightmare.
	measure 'TT Nightmare Detail' = SELECTEDVALUE ( Respondent[NightmareDetail], "" )
		displayFolder: Anatomy of Fear\8 Tooltips
		lineageTag: 0a09f54d-8900-4b63-abc2-94cbdd2be787

	/// Respondents choosing the hovered nightmare, of all respondents.
	measure 'TT Nightmare Text' = FORMAT ( [Responses], "0" ) & " of " & FORMAT ( CALCULATE ( [Responses], REMOVEFILTERS ( Respondent ) ), "0" ) & " respondents   " & UNICHAR ( 183 ) & "   " & FORMAT ( [Nightmare Share], "0.0%" )
		displayFolder: Anatomy of Fear\8 Tooltips
		lineageTag: c22cf5a0-1092-4804-86fd-1ae2b5edc5a5

	/// Respondents in the age group choosing the hovered nightmare.
	measure 'TT NM Count' = [Responses]
		formatString: #,0
		displayFolder: Anatomy of Fear\8 Tooltips
		lineageTag: 70a6a81b-fc17-4b8a-bffa-b123d4134664

	/// All respondents in the age group, regardless of nightmare.
	measure 'TT NM Size' = CALCULATE ( [Responses], REMOVEFILTERS ( Respondent[Nightmare], Respondent[NightmareDetail], Respondent[dataNightmare] ) )
		formatString: #,0
		displayFolder: Anatomy of Fear\8 Tooltips
		lineageTag: cdd8ffd8-a5cf-4d55-9718-9e86f2ca73bb

	/// Alt text for the ghost case-file tooltip.
	measure 'HTML TT Ghost Alt' =
			VAR _rk = SELECTEDVALUE ( Respondent[ResponseKey] )
			RETURN "Case file for response " & _rk & ": " & SELECTEDVALUE ( Respondent[FearsKept] ) & " identical fear(s) - " & SELECTEDVALUE ( Respondent[KeptFears] ) & ". Age group " & SELECTEDVALUE ( Respondent[AgeGroup] ) & ". Worst data nightmare: " & SELECTEDVALUE ( Respondent[Nightmare] ) & "."
		displayFolder: Anatomy of Fear\8 Tooltips
		lineageTag: 59a7e956-fb5a-4db0-ba72-4a1997e28bf2

	/// Tooltip animation: blinking eyes in the dark (decorative).
	measure 'HTML TT Eyes' = "<style>.ey{width:100%;height:100%;display:flex;align-items:center;justify-content:center}.ey svg{width:92%;height:auto}.ey .lid{animation:eyblink 4.2s infinite;transform-origin:center;transform-box:fill-box}.ey .pu{animation:eylook 5s ease-in-out infinite}.ey .glow{animation:eyglow 3s ease-in-out infinite}@keyframes eyblink{0%,44%,50%,100%{transform:scaleY(1)}47%{transform:scaleY(.05)}}@keyframes eylook{0%,20%{transform:translateX(0)}30%,45%{transform:translateX(-4px)}60%,75%{transform:translateX(4px)}90%,100%{transform:translateX(0)}}@keyframes eyglow{0%,100%{opacity:.35}50%{opacity:.7}}@media (prefers-reduced-motion: reduce){*{animation:none!important}}</style><div class='ey'><svg viewBox='0 0 80 52' aria-hidden='true' focusable='false'><ellipse class='glow' cx='40' cy='26' rx='38' ry='20' fill='#FFB886' opacity='.4' style='filter:blur(8px)'/><g class='lid'><ellipse cx='24' cy='26' rx='12' ry='8' fill='#FFE7C2'/><ellipse cx='56' cy='26' rx='12' ry='8' fill='#FFE7C2'/><g class='pu'><circle cx='24' cy='26' r='4.2' fill='#151020'/><circle cx='56' cy='26' r='4.2' fill='#151020'/><circle cx='25.5' cy='24.5' r='1.2' fill='#F4EBDD'/><circle cx='57.5' cy='24.5' r='1.2' fill='#F4EBDD'/></g></g></svg></div>"
