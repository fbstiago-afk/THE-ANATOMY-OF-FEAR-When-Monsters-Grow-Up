/// Respondent reported gender.
table DimGender
	lineageTag: 9037dd9e-1a55-4021-85d3-67b0ec37572c

	column GenderKey
		dataType: int64
		isHidden
		lineageTag: 4b77d124-d265-4caa-bd9d-0d93d5631ce6
		summarizeBy: none
		sourceColumn: GenderKey

	column Gender
		dataType: string
		lineageTag: a528a9a8-a954-4988-a5fb-3b134e6236a2
		summarizeBy: none
		sourceColumn: Gender

	partition DimGender = m
		mode: import
		source =
				let
				 Clean = (v as any) as text => if v = null or Text.Trim(Text.From(v)) = "" then "(Unknown)" else Text.Trim(Text.From(v)),
				 Parse = (v as any) as list => if v = null or Text.Trim(Text.From(v)) = "" then {} else let j = Json.Document(v) in if not Value.Is(j, type list) then error "Fear JSON must be a list" else List.Distinct(List.Select(List.Transform(j, each if _ = null then "" else Text.Trim(Text.From(_))), each _ <> "")),
				 Values = raw_survey_responses[gender],
				 Unique = List.Sort(List.Distinct(List.Transform(Values, each Clean(_)))),
				 Labels = Table.FromList(Unique, Splitter.SplitByNothing(), {"Gender"}),
				 Keys = Table.AddIndexColumn(Labels, "GenderKey", 1, 1, Int64.Type)
				in Keys

