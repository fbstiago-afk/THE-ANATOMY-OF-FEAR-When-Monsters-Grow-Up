"<style>.fg{width:100%;height:100%;display:flex;align-items:center;justify-content:center;overflow:hidden}.fg svg{width:88%;height:auto;filter:drop-shadow(0 0 16px rgba(189,154,247,.55));animation:fgfloat 7s ease-in-out infinite}.fg .eye{animation:fgblink 6s infinite;transform-origin:center;transform-box:fill-box}.fg .flame{animation:fgflick 1.8s ease-in-out infinite;transform-origin:50% 100%;transform-box:fill-box}@keyframes fgfloat{0%,100%{transform:translateY(4px)}50%{transform:translateY(-10px)}}@keyframes fgblink{0%,90%,100%{transform:scaleY(1)}93%{transform:scaleY(.08)}96%{transform:scaleY(1)}}@keyframes fgflick{0%,100%{transform:scale(1,1);opacity:1}50%{transform:scale(.88,1.12);opacity:.85}}@media (prefers-reduced-motion: reduce){.fg svg,.fg .eye,.fg .flame{animation:none}}</style><div class='fg'><svg viewBox='0 0 220 260' aria-hidden='true' focusable='false'><defs><linearGradient id='fgb' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#F4EBDD' stop-opacity='.92'/><stop offset='.55' stop-color='#D9CDE8' stop-opacity='.62'/><stop offset='1' stop-color='#BD9AF7' stop-opacity='0'/></linearGradient><radialGradient id='fgf' cx='.5' cy='.6' r='.5'><stop offset='0' stop-color='#FFF3D6'/><stop offset='.55' stop-color='#FFB886'/><stop offset='1' stop-color='#FF858E' stop-opacity='0'/></radialGradient></defs><path d='M112 18 C74 18 56 50 54 92 C51 138 44 176 24 218 C42 212 54 222 64 240 C74 226 86 228 98 244 C108 230 120 230 130 244 C140 230 152 228 164 238 C172 206 176 166 172 118 C168 58 150 18 112 18 Z' fill='url(#fgb)'/><path d='M60 150 C70 170 66 196 50 214' stroke='#F4EBDD' stroke-opacity='.25' stroke-width='3' fill='none'/><path d='M150 112 C158 150 160 188 154 226' stroke='#BD9AF7' stroke-opacity='.30' stroke-width='3' fill='none'/><ellipse class='eye' cx='95' cy='88' rx='7' ry='12' fill='#151020' transform='rotate(-8 95 88)'/><ellipse class='eye' cx='129' cy='88' rx='7' ry='12' fill='#151020' transform='rotate(8 129 88)'/><path d='M168 132 C182 136 