{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Tooltip: respondents naming the hovered fear, by age group (age when answering), childhood list vs current list.",
  "data": {
    "name": "dataset"
  },
  "width": "container",
  "height": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": {
    "left": 2,
    "right": 26,
    "top": 2,
    "bottom": 2
  },
  "background": "transparent",
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Segoe UI"
  },
  "transform": [
    {
      "fold": [
        "Childhood Respondents",
        "Now Respondents"
      ],
      "as": [
        "Period",
        "n"
      ]
    },
    {
      "calculate": "datum.n ? datum.n : 0",
      "as": "n"
    },
    {
      "calculate": "datum.Period == 'Childhood Respondents' ? 'As a child' : 'Today'",
      "as": "Period"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "n",
          "as": "mx"
        }
      ]
    },
    {
      "calculate": "max(datum.mx, 1) * 1.25",
      "as": "pad"
    }
  ],
  "encoding": {
    "y": {
      "field": "AgeGroup",
      "type": "ordinal",
      "sort": "ascending",
      "axis": {
        "title": null,
        "domain": false,
        "ticks": false,
        "labelColor": "#F4EBDD",
        "labelFontSize": 12,
        "labelPadding": 6
      },
      "scale": {
        "paddingInner": 0.25
      }
    },
    "yOffset": {
      "field": "Period",
      "sort": [
        "As a child",
        "Today"
      ],
      "scale": {
        "paddingInner": 0.1
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 2
      },
      "encoding": {
        "x": {
          "field": "n",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "zero": true,
            "nice": false
          }
        },
        "color": {
          "field": "Period",
          "type": "nominal",
          "scale": {
            "domain": [
              "As a child",
              "Today"
            ],
            "range": [
              "#8463BF",
              "#B8622F"
            ]
          },
          "legend": {
            "orient": "top",
            "title": null,
            "labelColor": "#F4EBDD",
            "labelFontSize": 12,
            "symbolType": "square",
            "direction": "horizontal"
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 4,
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#F4EBDD"
      },
      "encoding": {
        "x": {
          "field": "n",
          "type": "quantitative"
        },
        "text": {
          "field": "n"
        }
      }
    }
  ]
}