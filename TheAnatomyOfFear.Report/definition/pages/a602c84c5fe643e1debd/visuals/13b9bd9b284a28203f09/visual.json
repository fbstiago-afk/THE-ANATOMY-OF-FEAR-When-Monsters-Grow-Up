            },
            "jsonSpec": {
              "expr": {
                "Literal": {
                  "Value": "'{\n  \"$schema\": \"https://vega.github.io/schema/vega-lite/v5.json\",\n  \"description\": \"DATA NIGHTMARES - respondents choosing each answer to the single-choice data nightmare question. The most chosen answer is highlighted. Values from the Power BI model.\",\n  \"data\": {\n    \"name\": \"dataset\"\n  },\n  \"width\": \"container\",\n  \"height\": \"container\",\n  \"autosize\": {\n    \"type\": \"fit\",\n    \"contains\": \"padding\"\n  },\n  \"padding\": {\n    \"left\": 2,\n    \"right\": 6,\n    \"top\": 2,\n    \"bottom\": 2\n  },\n  \"background\": \"transparent\",\n  \"config\": {\n    \"view\": {\n      \"stroke\": null\n    },\n    \"font\": \"Segoe UI\"\n  },\n  \"transform\": [\n    {\n      \"joinaggregate\": [\n        {\n          \"op\": \"max\",\n          \"field\": \"Responses\",\n          \"as\": \"MX\"\n        }\n      ]\n    },\n    {\n      \"calculate\": \"datum.Responses + ''  ·  '' + format(datum[''Nightmare Share''], ''.1%'')\",\n      \"as\": \"lbl\"\n    },\n    {\n      \"calculate\": \"datum[''Nightmare Rank''] == 1\",\n      \"as\": \"isTop\"\n    },\n    {\n      \"calculate\": \"datum.MX*1.32\",\n      \"as\": \"pad\"\n    }\n  ],\n  \"encoding\": {\n    \"y\": {\n      \"field\": \"Nightmare\",\n      \"type\": \"nominal\",\n      \"sort\": {\n        \"field\": \"Responses\",\n        \"order\": \"descending\"\n      },\n      \"scale\": {\n        \"paddingInner\": 0.28\n      },\n      \"axis\": {\n        \"title\": null,\n        \"domain\": false,\n        \"ticks\": false,\n        \"labelColor\": \"#F4EBDD\",\n        \"labelFontSize\": 14,\n        \"labelPadding\": 10,\n        \"labelLimit\": 330,\n        \"labelFontWeight\": {\n          \"condition\": {\n            \"test\": \"datum.index == 0\",\n            \"value\": 700\n          },\n          \"value\": 400\n        }\n      }\n    },\n    \"x\": {\n      \"field\": \"Responses\",\n      \"type\": \"quantitative\",\n      \"axis\": null,\n      \"scale\": {\n        \"zero\": true,\n        \"nice\": false\n      }\n    }\n  },\n  \"layer\": [\n    {\n      \"mark\": {\n        \"type\": \"rule\",\n        \"opacity\": 0\n      },\n      \"encoding\": {\n        \"x\": {\n          \"field\": \"pad\",\n          \"type\": \"quantitative\"\n        },\n        \"y\": null\n      }\n    },\n    {\n      \"mark\": {\n        \"type\": \"bar\",\n        \"cornerRadiusEnd\": 3\n      },\n      \"encoding\": {\n        \"color\": {\n          \"condition\": {\n            \"test\": \"datum.isTop\",\n            \"value\": \"#FF858E\"\n          },\n          \"value\": \"#8463BF\"\n        },\n        \"tooltip\": [\n          {\n            \"field\": \"Nightmare\",\n            \"title\": \"Data nightmare\"\n          },\n          {\n            \"field\": \"Responses\",\n            \"title\": \"Respondents\"\n          },\n          {\n            \"field\": \"Nightmare Share\",\n            \"title\": \"Share of respondents\",\n            \"format\": \".1%\"\n          }\n        ]\n      }\n    },\n    {\n      \"mark\": {\n        \"type\": \"text\",\n        \"align\": \"left\",\n        \"baseline\": \"middle\",\n        \"dx\": 8,\n        \"fontSize\": 14,\n        \"fontWeight\": 600,\n        \"color\": \"#F4EBDD\"\n      },\n      \"encoding\": {\n        \"text\": {\n          \"field\": \"lbl\"\n        }\n      }\n    }\n  ]\n}'"
                }
