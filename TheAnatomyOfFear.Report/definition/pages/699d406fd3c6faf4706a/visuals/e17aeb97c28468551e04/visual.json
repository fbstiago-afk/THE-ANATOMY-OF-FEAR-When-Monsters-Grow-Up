            "jsonSpec": {
              "expr": {
                "Literal": {
                  "Value": "'{\n  \"$schema\": \"https://vega.github.io/schema/vega-lite/v5.json\",\n  \"description\": \"Tooltip: by age group (age when answering), share of respondents (left measure) with count of group (label).\",\n  \"data\": {\n    \"name\": \"dataset\"\n  },\n  \"width\": \"container\",\n  \"height\": \"container\",\n  \"autosize\": {\n    \"type\": \"fit\",\n    \"contains\": \"padding\"\n  },\n  \"padding\": {\n    \"left\": 2,\n    \"right\": 8,\n    \"top\": 2,\n    \"bottom\": 2\n  },\n  \"background\": \"transparent\",\n  \"config\": {\n    \"view\": {\n      \"stroke\": null\n    },\n    \"font\": \"Segoe UI\"\n  },\n  \"params\": [\n    {\n      \"name\": \"barColor\",\n      \"value\": \"#FF858E\"\n    }\n  ],\n  \"transform\": [\n    {\n      \"calculate\": \"datum[''TT NM Count''] ? datum[''TT NM Count''] : 0\",\n      \"as\": \"k\"\n    },\n    {\n      \"calculate\": \"datum[''TT NM Size''] ? datum[''TT NM Size''] : 0\",\n      \"as\": \"g\"\n    },\n    {\n      \"calculate\": \"datum.g > 0 ? datum.k / datum.g : 0\",\n      \"as\": \"share\"\n    },\n    {\n      \"calculate\": \"format(datum.share, ''.0%'') + ''  ·  '' + datum.k + '' of '' + datum.g\",\n      \"as\": \"lbl\"\n    }\n  ],\n  \"encoding\": {\n    \"y\": {\n      \"field\": \"AgeGroup\",\n      \"type\": \"ordinal\",\n      \"sort\": \"ascending\",\n      \"axis\": {\n        \"title\": null,\n        \"domain\": false,\n        \"ticks\": false,\n        \"labelColor\": \"#F4EBDD\",\n        \"labelFontSize\": 12,\n        \"labelPadding\": 6\n      }\n    }\n  },\n  \"layer\": [\n    {\n      \"mark\": {\n        \"type\": \"bar\",\n        \"color\": {\n          \"expr\": \"barColor\"\n        },\n        \"cornerRadiusEnd\": 2,\n        \"height\": {\n          \"band\": 0.7\n        }\n      },\n      \"encoding\": {\n        \"x\": {\n          \"field\": \"share\",\n          \"type\": \"quantitative\",\n          \"axis\": null,\n          \"scale\": {\n            \"domain\": [\n              0,\n              1.45\n            ],\n            \"nice\": false\n          }\n        }\n      }\n    },\n    {\n      \"mark\": {\n        \"type\": \"text\",\n        \"align\": \"left\",\n        \"baseline\": \"middle\",\n        \"dx\": 5,\n        \"fontSize\": 11.5,\n        \"fontWeight\": 600,\n        \"color\": \"#F4EBDD\"\n      },\n      \"encoding\": {\n        \"x\": {\n          \"field\": \"share\",\n          \"type\": \"quantitative\"\n        },\n        \"text\": {\n          \"field\": \"lbl\"\n        }\n      }\n    }\n  ]\n}'"
